# ==============================================================================
# mTRANSLATOR macOS & Web - Configuration d'environnement
# ==============================================================================

# Clé API Google Gemini (optionnelle pour le mode hors-ligne / glossaire local)
# Obtenez une clé gratuite sur https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Port d'écoute du serveur web local
PORT=3000

# Hôte d'écoute (0.0.0.0 pour réseau local/universel, 127.0.0.1 pour local uniquement)
HOST=0.0.0.0

# Environnement ('development' ou 'production')
NODE_ENV=development
